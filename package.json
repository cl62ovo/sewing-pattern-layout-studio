{
  "name": "plush-pattern-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "predev": "npm run legacy:sync && npm run db:migrate",
    "dev": "concurrently --kill-others-on-fail --names WEB,API,WORKER --prefix-colors cyan,green,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:web": "npm --workspace @plush-pattern-studio/web run dev",
    "dev:api": "python -m uvicorn plush_pattern_studio.api.main:app --reload --reload-dir services/backend/src --app-dir services/backend/src --port 8000",
    "dev:worker": "python -m plush_pattern_studio.worker.main",
    "db:migrate": "python -m plush_pattern_studio.infrastructure.migrate migrate",
    "fixtures:generate": "python services/backend/tools/generate_fixtures.py",
    "contracts:export": "python services/backend/tools/export_contracts.py",
    "legacy:sync": "node tools/sync-legacy.mjs",
    "geometry": "python -m plush_pattern_studio.geometry.cli",
    "build": "npm --workspace @plush-pattern-studio/web run build",
    "test:web": "npm --workspace @plush-pattern-studio/web run test",
    "test:backend": "python -m pytest services/backend/tests",
    "test": "npm run test:web && npm run test:backend"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}